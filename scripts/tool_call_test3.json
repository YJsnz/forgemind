            },
            "line_id": {"type": "integer", "description": "产线编号"},
            "speed": {"type": "number", "description": "速度百分比，0-100"},
            "machine_id": {"type": "integer", "description": "机器编号"},
            "recipe": {"type": "string", "description": "配方名称"}
          },
          "required": ["action"]
        }
      }
    }
  ],
  "stream": false
