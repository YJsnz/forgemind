{
  "name": "forgemind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ForgeMind — AI 驱动的智能工厂数字孪生设计与仿真平台",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop-web.ps1",
    "preview": "vite preview",
    "sim": "node scripts/run-sim.mjs",
    "sim:units": "node scripts/run-sim.mjs scripts/simulation-units.ts",
    "autopilot:units": "node scripts/run-sim.mjs scripts/autopilot-units.ts",
    "line-balance:units": "node scripts/run-sim.mjs scripts/line-balance-units.ts",
    "sim:regression": "node scripts/run-sim.mjs scripts/sim-regression.ts",
    "generative:regression": "node scripts/run-sim.mjs scripts/generative-regression.ts",
    "sim:smoke": "node scripts/run-sim.mjs scripts/sim-smoke.ts",
    "sim:backpressure": "node scripts/run-sim.mjs scripts/backpressure-check.ts",
    "assistant:protocol": "node scripts/run-sim.mjs scripts/assistant-protocol-check.ts",
    "agent:regression": "node scripts/run-sim.mjs scripts/agent-workflow-regression.ts",
    "agent:project-audit": "node scripts/run-sim.mjs scripts/agent-project-audit.ts",
    "interaction:regression": "node scripts/run-sim.mjs scripts/interaction-regression.ts",
    "selection:regression": "node scripts/run-sim.mjs scripts/selection-regression.ts",
    "selection:browser-audit": "node scripts/selection-browser-audit.mjs",
    "visual-scale:regression": "node scripts/run-sim.mjs scripts/visual-scale-regression.ts",
    "multifloor-conveyor:regression": "node scripts/run-sim.mjs scripts/multifloor-conveyor-regression.ts",
    "floor-visibility:regression": "node scripts/run-sim.mjs scripts/floor-visibility-regression.ts",
    "drone-navigation:regression": "node scripts/run-sim.mjs scripts/drone-navigation-regression.ts",
    "save:regression": "node scripts/run-sim.mjs scripts/save-regression.ts",
    "manufacturing:regression": "node scripts/run-sim.mjs scripts/manufacturing-regression.ts",
    "storage:regression": "node scripts/run-sim.mjs scripts/storage-logistics-regression.ts",
    "station-rack:browser-audit": "node scripts/station-rack-browser-audit.mjs",
    "models:previews": "node scripts/generate-item-previews.mjs",
    "models:validate": "node scripts/validate-item-models.mjs",
    "models:validate:strict": "node scripts/validate-item-models.mjs --strict",
    "models:refresh": "node scripts/generate-item-previews.mjs && node scripts/validate-item-models.mjs",
    "models:core:build": "node tools/item-models/build.mjs",
    "models:core:validate": "node tools/item-models/validate.mjs",
    "forgemove:validate": "node tools/validate-forgemove.mjs",
    "forgecloud:regression": "node scripts/forgecloud-regression.mjs",
    "forgecloud:intelligence:regression": "node scripts/forgecloud-intelligence-regression.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide": "^1.31.0",
    "lucide-react": "^1.31.0",
    "morphicons": "^1.7.1",
    "motion": "^13.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.169.0",
    "urdf-loader": "^0.13.1",
    "zustand": "^5.0.2"
