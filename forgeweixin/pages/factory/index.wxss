.loading { color: #637078; }
.headline { color: var(--fm-text, #252a28); font-family: var(--fm-font-title, sans-serif); font-size: 50rpx; font-weight: 400; margin: 12rpx 0 8rpx; }
.stat-grid { display: grid; grid-template-columns: 1fr 1fr; column-gap: 20rpx; }
.stat { margin-top: 20rpx; padding: 22rpx; }
.stat-value { color: #101820; font-size: 40rpx; font-weight: 800; margin-bottom: 8rpx; }
.section-title { margin-bottom: 18rpx; }
.object-row { display: flex; align-items: center; border-top: 1rpx solid var(--fm-edge, rgba(42, 50, 47, .16)); padding: 20rpx 0; }
.object-icon { width: 48rpx; height: 48rpx; line-height: 48rpx; background: var(--fm-cyan, #459ba0); color: #fff; font-family: var(--fm-font-mono, monospace); font-size: 20rpx; font-weight: 700; text-align: center; margin-right: 16rpx; }
.object-main { flex: 1; min-width: 0; }
.object-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.object-type { font-size: 21rpx; margin-top: 5rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.empty { padding: 30rpx 0; text-align: center; }
