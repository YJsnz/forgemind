<view class="page">
  <view class="eyebrow">ACCOUNT / CONNECTION</view>
  <view class="headline">我的</view>
  <view class="signal-rail"><text class="active">IDENTITY</text><view class="signal-rail-line"></view><text>SESSION</text><view class="signal-rail-line"></view><text>API</text></view>
  <view class="card account-card">
    <view class="avatar"><image src="../../assets/icons/user.svg" mode="aspectFit" /></view>
    <view><view class="account-name">{{username || 'ForgeMind 用户'}}</view><view class="muted">已通过后端会话认证</view></view>
  </view>
  <view class="card info-card">
    <view class="section-title">连接信息</view>
    <view class="info-row"><text class="muted">API 服务</text><text class="info-value">{{apiBaseUrl}}</text></view>
    <view class="info-row"><text class="muted">数据事实源</text><text>Spring Boot / MySQL</text></view>
    <view class="info-row"><text class="muted">当前端能力</text><text>查看与协作</text></view>
  </view>
  <button class="logout" loading="{{loggingOut}}" disabled="{{loggingOut}}" bindtap="logout">退出登录</button>
</view>
