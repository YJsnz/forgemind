.headline { color: var(--fm-text, #252a28); font-family: var(--fm-font-title, sans-serif); font-size: 52rpx; font-weight: 400; margin: 14rpx 0; }
.account-card { display: flex; align-items: center; }
.avatar { width: 76rpx; height: 76rpx; line-height: 76rpx; background: var(--fm-accent, #e7ad18); color: var(--fm-text, #252a28); text-align: center; font-size: 32rpx; font-weight: 800; margin-right: 18rpx; }
.avatar image { width: 42rpx; height: 42rpx; margin: 17rpx; }
.account-name { font-family: var(--fm-font-title, sans-serif); font-size: 34rpx; font-weight: 400; margin-bottom: 8rpx; }
.info-card { padding-bottom: 12rpx; }
.info-row { display: flex; justify-content: space-between; gap: 20rpx; border-top: 1rpx solid var(--fm-edge, rgba(42, 50, 47, .16)); padding: 22rpx 0; font-size: 24rpx; }
.info-value { max-width: 420rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.logout { background: var(--fm-panel, #f9faf8); color: var(--fm-danger, #c95b54); border: 1rpx solid #d9a7a2; margin-top: 28rpx; }
