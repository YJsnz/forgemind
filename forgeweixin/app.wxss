@import "./styles/theme.wxss";

page {
  background: var(--fm-bg, #e9ecea);
  color: var(--fm-text, #252a28);
  font-family: var(--fm-font-sans, "Microsoft YaHei", sans-serif);
  font-size: 28rpx;
}

button {
  border-radius: 0;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  padding: 42rpx 32rpx 64rpx;
  background: var(--fm-bg-2, #f7f8f6);
}

.page::before {
  content: "";
  position: absolute;
  top: 0;
  right: -40rpx;
  width: 220rpx;
  height: 220rpx;
  opacity: .36;
  background-image: radial-gradient(var(--fm-cyan, #459ba0) 1.5rpx, transparent 1.5rpx);
  background-size: 18rpx 18rpx;
  pointer-events: none;
}

.eyebrow {
  position: relative;
  color: #6550c7;
  font-family: var(--fm-font-mono, monospace);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.muted {
  color: #75808a;
}

.error {
  color: #9c3d39;
  background: #fbe9e6;
  border-left: 6rpx solid var(--fm-danger, #c95b54);
  padding: 16rpx;
  margin: 20rpx 0;
}

.card {
  position: relative;
  background: var(--fm-panel, #f9faf8);
  border: 1rpx solid var(--fm-edge, rgba(42, 50, 47, .16));
  box-shadow: 6rpx 6rpx 0 rgba(69, 155, 160, .10);
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 26rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: var(--fm-font-title, sans-serif);
  font-size: 34rpx;
  font-weight: 400;
}

.link {
  color: #6550c7;
  font-size: 24rpx;
}

.primary {
  background: var(--fm-text, #252a28);
  color: #fff;
}

.signal-rail { position: relative; display: flex; align-items: center; gap: 10rpx; margin-top: 26rpx; color: var(--fm-text-faint, #9ba49f); font-family: var(--fm-font-mono, monospace); font-size: 17rpx; letter-spacing: 1rpx; }
.signal-rail text.active { color: var(--fm-text, #252a28); font-weight: 700; }
.signal-rail-line { display: block; width: 24rpx; height: 2rpx; background: var(--fm-accent, #e7ad18); }
