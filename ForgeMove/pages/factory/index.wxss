.factory-nav { display: flex; align-items: center; justify-content: space-between; color: var(--fm-muted); }.factory-nav button { color: var(--fm-purple); font-size: 22rpx; }.factory-nav .eyebrow { color: var(--fm-muted); }.factory-hero { margin-top: 25rpx; padding: 25rpx 22rpx 20rpx; }.factory-hero-top { display: flex; align-items: flex-start; justify-content: space-between; }.factory-name { max-width: 450rpx; margin-top: 13rpx; color: #f4f6f1; font-family: Georgia, serif; font-size: 42rpx; font-weight: 700; line-height: 1.1; }.factory-owner { margin-top: 9rpx; color: rgba(244,246,241,.5); font-family: monospace; font-size: 16rpx; }.factory-summary { margin-top: 23rpx; padding-top: 17rpx; border-top: 1rpx solid rgba(255,255,255,.12); color: rgba(244,246,241,.63); font-size: 21rpx; line-height: 1.65; }.factory-stat-row { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 22rpx; padding-top: 17rpx; border-top: 1rpx solid rgba(255,255,255,.12); }.factory-stat-row view { display: grid; gap: 5rpx; }.factory-stat-row text { color: #f4f6f1; font-family: Georgia, serif; font-size: 33rpx; font-weight: 700; }.factory-stat-row small { color: rgba(244,246,241,.48); font-size: 16rpx; }.floor-list { display: grid; gap: 13rpx; }.floor-card { display: flex; align-items: flex-start; gap: 15rpx; padding: 20rpx 17rpx; }.floor-index { display: flex; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; color: var(--fm-purple); background: rgba(124,94,222,.1); font-family: monospace; font-size: 17rpx; }.floor-main { min-width: 0; flex: 1; }.floor-name { color: var(--fm-ink); font-size: 25rpx; font-weight: 800; }.floor-note { margin-top: 6rpx; color: var(--fm-muted); font-size: 19rpx; }.floor-foot { display: flex; justify-content: space-between; margin-top: 16rpx; color: var(--fm-muted); font-family: monospace; font-size: 16rpx; }.floor-foot text:first-child { display: flex; align-items: center; }.floor-foot .status-dot { width: 11rpx; height: 11rpx; }.floor-arrow { color: var(--fm-purple); font-size: 32rpx; }.boundary-card { display: flex; gap: 14rpx; margin-top: 23rpx; padding: 20rpx 18rpx; }.boundary-icon { display: flex; width: 42rpx; height: 42rpx; flex: none; align-items: center; justify-content: center; color: #9e7210; background: rgba(225,170,35,.16); font-weight: 800; }.boundary-title { color: var(--fm-ink); font-size: 23rpx; font-weight: 800; }.boundary-copy { margin-top: 6rpx; color: var(--fm-muted); font-size: 19rpx; line-height: 1.55; }.archive-button { margin-top: 22rpx; }

