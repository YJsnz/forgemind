.dashboard-head { display: flex; align-items: flex-start; justify-content: space-between; }.dash-title { margin-top: 14rpx; font-family: Georgia, serif; font-size: 52rpx; font-weight: 700; letter-spacing: -.06em; }.dash-copy { margin-top: 10rpx; color: var(--fm-muted); font-size: 24rpx; }.refresh-button { display: flex; width: 62rpx; height: 62rpx; align-items: center; justify-content: center; border: 1rpx solid var(--fm-line); color: var(--fm-purple); background: rgba(255,255,255,.7); font-size: 38rpx; }
.source-banner { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; padding: 15rpx 18rpx; border-top: 1rpx solid var(--fm-line); border-bottom: 1rpx solid var(--fm-line); color: var(--fm-muted); font-family: var(--fm-mono); font-size: 18rpx; letter-spacing: .04em; }.source-left { display: flex; align-items: center; color: var(--fm-ink); font-family: -apple-system-font, sans-serif; font-size: 22rpx; }.source-dot { width: 12rpx; height: 12rpx; margin-right: 10rpx; border-radius: 50%; background: var(--fm-amber); }.source-dot.is-online { background: var(--fm-green); box-shadow: 0 0 0 6rpx rgba(63,179,167,.12); }.source-meta { font-size: 16rpx; }
.current-factory { margin-top: 26rpx; padding: 26rpx 24rpx 22rpx; }.factory-top { display: flex; align-items: flex-start; justify-content: space-between; }.factory-title { max-width: 390rpx; margin-top: 12rpx; color: #f4f6f1; font-family: Georgia, serif; font-size: 39rpx; font-weight: 700; line-height: 1.1; }.factory-code { margin-top: 12rpx; color: rgba(244,246,241,.5); font-family: monospace; font-size: 17rpx; }.factory-foot { display: flex; gap: 16rpx; margin-top: 25rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(255,255,255,.11); color: rgba(244,246,241,.62); font-size: 22rpx; line-height: 1.6; }.factory-foot text:first-child { flex: 1; }.arrow { color: #e1aa23; font-size: 31rpx; }
.pulse-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }.pulse-card { min-height: 194rpx; padding: 20rpx 18rpx; }.pulse-label { color: var(--fm-muted); font-family: monospace; font-size: 16rpx; font-weight: 700; letter-spacing: .08em; }.pulse-value { margin-top: 20rpx; color: var(--fm-ink); font-family: Georgia, serif; font-size: 47rpx; font-weight: 700; letter-spacing: -.05em; }.pulse-value text { margin-left: 5rpx; color: var(--fm-muted); font-family: monospace; font-size: 18rpx; letter-spacing: 0; }.pulse-bar { height: 6rpx; margin-top: 12rpx; background: rgba(18,25,28,.09); }.pulse-bar view { height: 100%; background: var(--fm-green); }.pulse-bar.amber view { background: var(--fm-amber); }.pulse-bar.purple view { background: var(--fm-purple); }.pulse-note { margin-top: 12rpx; color: var(--fm-muted); font-size: 18rpx; line-height: 1.35; }.positive { color: #2d9a83; }
.alert-list { display: grid; gap: 12rpx; }.alert-card { display: flex; align-items: center; gap: 16rpx; padding: 19rpx 17rpx; }.alert-mark { width: 10rpx; height: 76rpx; flex: none; background: var(--fm-green); }.tone-warning { background: var(--fm-amber); }.tone-amber { background: var(--fm-purple); }.alert-body { min-width: 0; flex: 1; }.alert-label { color: var(--fm-muted); font-family: monospace; font-size: 16rpx; }.alert-title { margin-top: 5rpx; color: var(--fm-ink); font-size: 25rpx; font-weight: 700; }.alert-detail { margin-top: 7rpx; color: var(--fm-muted); font-size: 19rpx; }.alert-arrow { color: var(--fm-purple); font-size: 34rpx; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.quick-item { min-height: 154rpx; padding: 18rpx; }.quick-icon { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; margin-bottom: 20rpx; font-size: 28rpx; }.quick-icon.cyan { color: var(--fm-green); background: rgba(63,179,167,.12); }.quick-icon.amber { color: #9e7210; background: rgba(225,170,35,.17); }.quick-icon.purple { color: var(--fm-purple); background: rgba(124,94,222,.12); }.quick-icon.green { color: #287c59; background: rgba(84,170,112,.13); }.quick-label { color: var(--fm-ink); font-size: 25rpx; font-weight: 800; }.quick-note { margin-top: 6rpx; color: var(--fm-muted); font-size: 18rpx; }
.activity-list { padding: 3rpx 20rpx; }.activity-row { display: flex; align-items: flex-start; gap: 15rpx; padding: 19rpx 0; border-bottom: 1rpx solid var(--fm-line); }.activity-row:last-child { border-bottom: 0; }.activity-time { width: 74rpx; flex: none; color: var(--fm-muted); font-family: monospace; font-size: 17rpx; }.activity-signal { width: 12rpx; height: 12rpx; margin-top: 5rpx; border: 2rpx solid var(--fm-green); border-radius: 50%; }.activity-body { flex: 1; }.activity-title { color: var(--fm-ink); font-size: 23rpx; font-weight: 700; }.activity-detail { margin-top: 5rpx; color: var(--fm-muted); font-size: 18rpx; }

