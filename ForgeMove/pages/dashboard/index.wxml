<view class="page dashboard-page">
  <view class="dashboard-head fade-in"><view><view class="eyebrow">FORGEMOVE / FIELD CONSOLE</view><view class="dash-title">早上好，{{user}}</view><view class="dash-copy">先看信号，再决定下一步。</view></view><button class="refresh-button" bindtap="refresh">↻</button></view>
  <view class="source-banner fade-in delay-1"><view class="source-left"><view class="source-dot {{online ? 'is-online' : ''}}"></view><text>{{online ? '在线同步' : '离线演示'}}</text></view><text class="source-meta">{{online ? 'SPRING BOOT / LIVE' : 'LOCAL SNAPSHOT'}}</text></view>
  <view class="current-factory card-dark fade-in delay-1" bindtap="openFactory"><view class="factory-top"><view><view class="eyebrow eyebrow-light">CURRENT WORK UNIT</view><view class="factory-title">{{factory.name}}</view><view class="factory-code">{{factory.code}} · v{{factory.version}}</view></view><status-orb state="{{factory.status === 'warning' ? 'warning' : 'running'}}" label="{{factory.status === 'synced' ? 'SYNCED' : 'RUNNING'}}" compact="{{false}}"></status-orb></view><view class="factory-foot"><text>{{factory.summary}}</text><text class="arrow">↗</text></view></view>
  <view class="section-head fade-in delay-2"><view class="section-title">Factory Pulse</view><view class="section-meta">{{pulse.window}}</view></view>
  <view class="pulse-grid fade-in delay-2"><view class="pulse-card card"><view class="pulse-label">THROUGHPUT</view><view class="pulse-value">{{pulse.throughput}}<text>%</text></view><view class="pulse-bar"><view style="width: {{pulse.throughput}}%"></view></view><view class="pulse-note">较上一窗口 <text class="positive">+8.4%</text></view></view><view class="pulse-card card"><view class="pulse-label">UTILIZATION</view><view class="pulse-value">{{pulse.utilization}}<text>%</text></view><view class="pulse-bar amber"><view style="width: {{pulse.utilization}}%"></view></view><view class="pulse-note">设备有效利用率</view></view><view class="pulse-card card"><view class="pulse-label">OEE INDEX</view><view class="pulse-value">{{pulse.oee}}<text>%</text></view><view class="pulse-bar purple"><view style="width: {{pulse.oee}}%"></view></view><view class="pulse-note">确定性仿真证据</view></view><view class="pulse-card card"><view class="pulse-label">ENERGY / UNIT</view><view class="pulse-value">{{pulse.energy}}<text>kWh</text></view><view class="pulse-note">目标内 · -3.1%</view></view></view>
  <view class="section-head"><view class="section-title">现场信号</view><view class="section-meta">{{pulse.updated}}</view></view>
  <view class="alert-list"><block wx:for="{{alerts}}" wx:key="title"><view class="alert-card card"><view class="alert-mark tone-{{item.tone}}"></view><view class="alert-body"><view class="alert-label">{{item.label}}</view><view class="alert-title">{{item.title}}</view><view class="alert-detail">{{item.detail}}</view></view><text class="alert-arrow">›</text></view></block></view>
  <view class="section-head"><view class="section-title">快捷入口</view><view class="section-meta">MOVE / ACT</view></view>
  <view class="quick-grid"><button class="quick-item card" data-page="monitor" bindtap="openPage"><view class="quick-icon cyan">⌁</view><view class="quick-label">看产线</view><view class="quick-note">3 个工作单元</view></button><button class="quick-item card" data-page="tasks" bindtap="openPage"><view class="quick-icon amber">✓</view><view class="quick-label">处理任务</view><view class="quick-note">3 项待处理</view></button><button class="quick-item card" data-page="inventory" bindtap="openPage"><view class="quick-icon purple">▦</view><view class="quick-label">查物料</view><view class="quick-note">2 个低库存</view></button><button class="quick-item card" data-page="community" bindtap="openPage"><view class="quick-icon green">✦</view><view class="quick-label">进社区</view><view class="quick-note">8 条新讨论</view></button></view>
  <view class="section-head"><view class="section-title">最近动态</view><view class="section-meta">ACTIVITY LOG</view></view>
  <view class="activity-list card"><block wx:for="{{activity}}" wx:key="time"><view class="activity-row"><view class="activity-time">{{item.time}}</view><view class="activity-signal"></view><view class="activity-body"><view class="activity-title">{{item.title}}</view><view class="activity-detail">{{item.detail}}</view></view></view></block></view>
</view>

