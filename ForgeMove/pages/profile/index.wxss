.profile-card { display: flex; align-items: center; gap: 16rpx; margin-top: 30rpx; padding: 23rpx 20rpx; }.profile-avatar { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; color: var(--fm-ink); background: var(--fm-amber); font-family: Georgia, serif; font-size: 31rpx; font-weight: 800; }.profile-main { min-width: 0; flex: 1; }.profile-name { color: #f4f6f1; font-family: Georgia, serif; font-size: 31rpx; font-weight: 700; }.profile-role { margin-top: 5rpx; color: rgba(244,246,241,.47); font-family: monospace; font-size: 15rpx; letter-spacing: .07em; }.profile-session { display: flex; align-items: center; margin-top: 13rpx; color: rgba(244,246,241,.68); font-size: 18rpx; }.profile-arrow { align-self: flex-start; color: #e1aa23; font-size: 29rpx; }.setting-list { padding: 0 18rpx; }.setting-row { display: flex; align-items: center; justify-content: space-between; min-height: 95rpx; border-bottom: 1rpx solid var(--fm-line); }.setting-row:last-child { border-bottom: 0; }.setting-title { color: var(--fm-ink); font-size: 24rpx; font-weight: 700; }.setting-note { margin-top: 5rpx; color: var(--fm-muted); font-size: 18rpx; }.connection-card { padding: 0 18rpx; }.connection-row { display: flex; align-items: center; gap: 13rpx; min-height: 93rpx; border-bottom: 1rpx solid var(--fm-line); }.connection-row:last-child { border-bottom: 0; }.connection-icon { display: flex; width: 45rpx; height: 45rpx; align-items: center; justify-content: center; font-size: 28rpx; }.connection-icon.green { color: var(--fm-green); background: rgba(63,179,167,.12); }.connection-icon.purple { color: var(--fm-purple); background: rgba(124,94,222,.12); }.connection-content { min-width: 0; flex: 1; }.connection-title { color: var(--fm-ink); font-size: 22rpx; font-weight: 700; }.connection-note { margin-top: 5rpx; color: var(--fm-muted); font-size: 17rpx; }.connection-state { color: var(--fm-green); font-family: monospace; font-size: 16rpx; font-weight: 700; }.profile-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 22rpx; }.profile-actions button { min-height: 68rpx; font-size: 20rpx; }.clean-button { display: flex; width: 100%; min-height: 70rpx; align-items: center; justify-content: center; margin-top: 15rpx; color: var(--fm-muted); font-size: 20rpx; }.logout-button { display: flex; width: 100%; min-height: 72rpx; align-items: center; justify-content: center; margin-top: 5rpx; color: var(--fm-red); border: 1rpx solid rgba(201,99,95,.35); font-size: 21rpx; font-weight: 700; }.profile-foot { margin-top: 35rpx; color: var(--fm-muted); font-family: monospace; font-size: 16rpx; line-height: 1.7; text-align: center; }
