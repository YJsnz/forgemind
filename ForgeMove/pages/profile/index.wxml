<view class="page profile-page"><view class="eyebrow fade-in">PROFILE / SETTINGS</view><view class="title fade-in">我的</view><view class="profile-card card-dark fade-in delay-1"><view class="profile-avatar">{{avatar}}</view><view class="profile-main"><view class="profile-name">{{user}}</view><view class="profile-role">FIELD ENGINEER · FORGEMOVE</view><view class="profile-session"><view class="status-dot status-dot-{{demo ? 'warning' : 'running'}}"></view>{{demo ? '离线演示会话' : 'ForgeMind 已验证会话'}}</view></view><text class="profile-arrow">↗</text></view><view class="section-head"><view class="section-title">运行偏好</view><view class="section-meta">LOCAL ONLY</view></view><view class="setting-list card"><view class="setting-row"><view><view class="setting-title">任务提醒</view><view class="setting-note">本机提醒下一项现场任务</view></view><switch checked="{{notify}}" color="#3fb3a7" bindchange="toggleNotify" /></view><view class="setting-row"><view><view class="setting-title">减少动效</view><view class="setting-note">关闭状态脉冲与页面入场动画</view></view><switch checked="{{reducedMotion}}" color="#7c5ede" bindchange="toggleMotion" /></view></view><view class="section-head"><view class="section-title">连接状态</view><view class="section-meta">BOUNDARY</view></view><view class="connection-card card"><view class="connection-row"><view class="connection-icon green">⌁</view><view class="connection-content"><view class="connection-title">ForgeMind API</view><view class="connection-note">{{demo ? '演示数据 · 不会写入服务端' : 'Bearer 会话 · 结构摘要读取'}}</view></view><text class="connection-state">{{demo ? 'DEMO' : 'READY'}}</text></view><view class="connection-row"><view class="connection-icon purple">◎</view><view class="connection-content"><view class="connection-title">ForgeLab 社区</view><view class="connection-note">动态、求助和经验分享</view></view><text class="connection-state">{{demo ? 'LOCAL' : 'LIVE'}}</text></view></view><view class="profile-actions"><button class="secondary" bindtap="openHelp">使用边界</button><button class="secondary" bindtap="openLicense">开源许可</button></view><button class="clean-button" bindtap="clearLocal">清理本地数据</button><button class="logout-button" bindtap="logout">退出当前会话</button><view class="profile-foot">ForgeMove {{build}} · Built for ForgeMind<br/>本页设置仅保存在当前设备</view></view>
