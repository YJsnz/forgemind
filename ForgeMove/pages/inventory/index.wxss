.inventory-hero { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; padding: 25rpx 22rpx; }.hero-kicker { color: #e1aa23; font-family: monospace; font-size: 16rpx; letter-spacing: .1em; }.hero-number { margin-top: 10rpx; color: #f4f6f1; font-family: Georgia, serif; font-size: 60rpx; font-weight: 700; letter-spacing: -.06em; }.hero-number text { color: rgba(244,246,241,.52); font-family: -apple-system-font, sans-serif; font-size: 21rpx; font-weight: 400; letter-spacing: 0; }.hero-note { margin-top: 7rpx; color: rgba(244,246,241,.53); font-size: 19rpx; }.warehouse-glyph { display: grid; grid-template-columns: repeat(3, 20rpx); align-items: end; gap: 5rpx; height: 68rpx; padding: 7rpx; border: 1rpx solid rgba(225,170,35,.6); }.warehouse-glyph view { background: #e1aa23; }.warehouse-glyph view:nth-child(1) { height: 28rpx; }.warehouse-glyph view:nth-child(2) { height: 43rpx; }.warehouse-glyph view:nth-child(3) { height: 54rpx; }.inventory-search { display: flex; height: 70rpx; align-items: center; gap: 10rpx; margin-top: 22rpx; padding: 0 16rpx; }.search-icon { color: var(--fm-purple); font-size: 34rpx; }.inventory-search input { min-width: 0; flex: 1; height: 100%; color: var(--fm-ink); font-size: 22rpx; }.inventory-search input::placeholder { color: #a0aaab; }.inventory-search button { color: var(--fm-muted); font-size: 32rpx; }.inventory-tabs { display: flex; margin-top: 15rpx; border-bottom: 1rpx solid var(--fm-line); }.inventory-tab { min-height: 67rpx; margin-right: 29rpx; color: var(--fm-muted); font-size: 22rpx; }.inventory-tab text { display: inline-flex; min-width: 30rpx; height: 30rpx; align-items: center; justify-content: center; margin-left: 5rpx; border-radius: 20rpx; color: #fff; background: var(--fm-purple); font-size: 16rpx; }.inventory-active { color: var(--fm-purple); border-bottom: 4rpx solid var(--fm-purple); font-weight: 800; }.inventory-list { display: grid; gap: 14rpx; margin-top: 20rpx; }.inventory-card { padding: 20rpx 18rpx 17rpx; }.inventory-top { display: flex; align-items: flex-start; justify-content: space-between; }.item-code { color: var(--fm-muted); font-family: monospace; font-size: 16rpx; }.item-name { margin-top: 8rpx; color: var(--fm-ink); font-size: 27rpx; font-weight: 800; }.stock-row { display: flex; align-items: baseline; margin-top: 22rpx; }.stock-number { color: var(--fm-ink); font-family: Georgia, serif; font-size: 44rpx; font-weight: 700; }.stock-unit { margin-left: 8rpx; color: var(--fm-muted); font-family: monospace; font-size: 17rpx; }.stock-state { margin-left: auto; color: var(--fm-muted); font-size: 18rpx; }.stock-bar { position: relative; height: 8rpx; margin-top: 15rpx; background: rgba(18,25,28,.08); }.stock-fill { height: 100%; }.fill-cyan { background: var(--fm-green); }.fill-amber { background: var(--fm-amber); }.fill-purple { background: var(--fm-purple); }.fill-green { background: #55aa70; }.safe-line { position: absolute; top: -4rpx; left: 50%; height: 16rpx; border-left: 2rpx dashed rgba(18,25,28,.37); }.inventory-foot { display: flex; justify-content: space-between; margin-top: 14rpx; color: var(--fm-muted); font-size: 18rpx; }.inventory-arrow { color: var(--fm-purple); font-size: 30rpx; }.inventory-note { display: grid; gap: 5rpx; margin-top: 23rpx; color: var(--fm-muted); font-size: 17rpx; line-height: 1.5; }

