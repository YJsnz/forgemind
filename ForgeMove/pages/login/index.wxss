.login-page { min-height: 100vh; overflow: hidden; color: #f4f6f1; background: #12191c; }
.login-grid { position: fixed; inset: 0; opacity: .32; background-image: linear-gradient(rgba(255,255,255,.04) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(255,255,255,.04) 1rpx, transparent 1rpx); background-size: 46rpx 46rpx; }
.login-orbit { position: fixed; border: 1rpx solid rgba(63,179,167,.17); border-radius: 50%; pointer-events: none; }
.orbit-one { top: -170rpx; left: -220rpx; width: 700rpx; height: 700rpx; }
.orbit-two { right: -310rpx; bottom: -120rpx; width: 760rpx; height: 760rpx; border-color: rgba(124,94,222,.2); }
.login-content { position: relative; z-index: 1; width: 100%; padding: 46rpx 36rpx 44rpx; }
.brand-line { display: flex; flex-direction: column; align-items: flex-start; gap: 12rpx; }
.brand-logo { display: block; width: 310rpx; height: 150rpx; padding: 8rpx; background: #f4f6f1; object-fit: contain; }
.brand-mark { display: flex; width: 62rpx; height: 62rpx; align-items: center; justify-content: center; color: #12191c; background: #e1aa23; font-family: monospace; font-size: 22rpx; font-weight: 900; letter-spacing: -.08em; }
.brand-name { font-family: Georgia, serif; font-size: 34rpx; font-weight: 700; letter-spacing: -.04em; }
.brand-code { margin-top: 0; color: rgba(244,246,241,.46); font-family: monospace; font-size: 15rpx; letter-spacing: .1em; }
.login-hero { margin-top: 86rpx; }
.login-hero .eyebrow { color: #68ded0; }
.hero-title { margin-top: 18rpx; color: #f4f6f1; font-family: Georgia, serif; font-size: 86rpx; font-weight: 700; line-height: .98; letter-spacing: -.08em; }
.hero-title text { color: #e1aa23; }
.hero-copy { max-width: 580rpx; margin-top: 24rpx; color: rgba(244,246,241,.62); font-size: 26rpx; line-height: 1.75; }
.signal-row { display: flex; align-items: center; gap: 16rpx; margin-top: 38rpx; color: rgba(244,246,241,.43); font-family: monospace; font-size: 16rpx; letter-spacing: .08em; }
.signal-word.active { color: #68ded0; }.signal-line { width: 45rpx; border-top: 1rpx solid rgba(244,246,241,.19); }
.login-card { margin-top: 48rpx; padding: 32rpx 28rpx 24rpx; border: 1rpx solid rgba(255,255,255,.15); background: rgba(28,39,43,.91); box-shadow: 14rpx 14rpx 0 rgba(0,0,0,.22); }
.login-card-head { display: flex; align-items: flex-start; justify-content: space-between; padding-bottom: 24rpx; border-bottom: 1rpx solid rgba(255,255,255,.11); }
.login-card-title { margin-top: 12rpx; font-family: Georgia, serif; font-size: 38rpx; font-weight: 700; letter-spacing: -.04em; }
.session-light { width: 16rpx; height: 16rpx; margin-top: 9rpx; border-radius: 50%; background: #68ded0; box-shadow: 0 0 0 10rpx rgba(63,179,167,.12), 0 0 26rpx rgba(63,179,167,.45); }
.field { display: grid; gap: 12rpx; margin-top: 24rpx; color: rgba(244,246,241,.59); font-family: monospace; font-size: 18rpx; letter-spacing: .07em; }
.field input { width: 100%; height: 80rpx; padding: 0 18rpx; border: 1rpx solid rgba(255,255,255,.15); color: #f4f6f1; background: rgba(18,25,28,.76); font-family: -apple-system-font, sans-serif; font-size: 25rpx; letter-spacing: 0; }
.field input:focus { border-color: #3fb3a7; }
.field input::placeholder { color: rgba(244,246,241,.28); }
.login-error { display: flex; align-items: center; gap: 10rpx; margin-top: 18rpx; color: #f2c853; font-size: 22rpx; line-height: 1.5; }
.error-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #e1aa23; }
.login-button { display: flex; min-height: 82rpx; align-items: center; justify-content: space-between; margin-top: 26rpx; padding: 0 22rpx; color: #12191c; background: #e1aa23; font-size: 27rpx; font-weight: 800; }
.button-arrow { font-size: 32rpx; }.login-button[disabled] { opacity: .55; }
.mode-button { width: 100%; margin-top: 20rpx; color: #68ded0; font-size: 22rpx; text-align: center; }
.login-divider { display: flex; align-items: center; gap: 14rpx; margin: 24rpx 0; color: rgba(244,246,241,.3); font-size: 18rpx; }.login-divider view { flex: 1; border-top: 1rpx solid rgba(255,255,255,.11); }
.demo-button { display: flex; width: 100%; align-items: center; gap: 14rpx; padding: 16rpx; border: 1rpx solid rgba(255,255,255,.12); color: #f4f6f1; background: rgba(255,255,255,.04); }
.demo-icon { display: flex; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; color: #68ded0; border: 1rpx solid rgba(63,179,167,.45); font-size: 30rpx; }
.demo-button view:last-child { display: grid; gap: 4rpx; }.demo-title { font-size: 23rpx; font-weight: 700; }.demo-caption { color: rgba(244,246,241,.46); font-size: 18rpx; }
.login-foot { display: flex; justify-content: space-between; margin-top: 22rpx; color: rgba(244,246,241,.34); font-family: monospace; font-size: 15rpx; letter-spacing: .08em; }
