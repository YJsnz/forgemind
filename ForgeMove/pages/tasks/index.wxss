.task-summary { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; padding: 25rpx 22rpx; }.summary-kicker { color: #68ded0; font-family: monospace; font-size: 16rpx; letter-spacing: .1em; }.summary-title { margin-top: 11rpx; color: #f4f6f1; font-family: Georgia, serif; font-size: 58rpx; font-weight: 700; }.summary-title text { color: rgba(244,246,241,.56); font-family: -apple-system-font, sans-serif; font-size: 22rpx; font-weight: 400; }.summary-note { margin-top: 8rpx; color: rgba(244,246,241,.52); font-size: 19rpx; }.summary-check { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(63,179,167,.6); color: #68ded0; font-size: 35rpx; }.task-tabs { display: flex; margin-top: 26rpx; border-bottom: 1rpx solid var(--fm-line); }.task-tab { min-height: 68rpx; margin-right: 30rpx; color: var(--fm-muted); font-size: 23rpx; }.tab-active { color: var(--fm-purple); border-bottom: 4rpx solid var(--fm-purple); font-weight: 800; }.task-list { display: grid; gap: 13rpx; margin-top: 20rpx; }.task-card { display: flex; gap: 16rpx; padding: 20rpx 17rpx; }.task-done { opacity: .58; }.task-check { display: flex; width: 40rpx; height: 40rpx; flex: none; align-items: center; justify-content: center; margin-top: 2rpx; border: 2rpx solid var(--fm-purple); color: #fff; background: transparent; font-size: 23rpx; }.check-done { border-color: var(--fm-green); background: var(--fm-green); }.task-main { min-width: 0; flex: 1; }.task-meta { display: flex; align-items: center; justify-content: space-between; }.task-due { color: var(--fm-muted); font-family: monospace; font-size: 17rpx; }.task-title { margin-top: 12rpx; color: var(--fm-ink); font-size: 25rpx; font-weight: 800; line-height: 1.42; }.task-detail { margin-top: 7rpx; color: var(--fm-muted); font-size: 19rpx; line-height: 1.5; }.task-owner { margin-top: 12rpx; color: var(--fm-muted); font-family: monospace; font-size: 16rpx; }.new-task { margin-top: 22rpx; padding: 20rpx 18rpx; }.new-task-label { color: var(--fm-purple); font-family: monospace; font-size: 16rpx; font-weight: 700; letter-spacing: .08em; }.new-task input { width: 100%; height: 66rpx; margin-top: 13rpx; padding: 0 14rpx; border: 1rpx solid var(--fm-line); color: var(--fm-ink); font-size: 22rpx; background: rgba(241,242,238,.75); }.new-task input::placeholder { color: #9ca6a7; }.new-task-button { display: flex; min-height: 62rpx; align-items: center; justify-content: center; margin-top: 13rpx; color: #fff; background: var(--fm-purple); font-size: 21rpx; font-weight: 700; }
