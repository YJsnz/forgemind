<view class="page tasks-page"><view class="eyebrow fade-in">TASKS / FIELD ACTIONS</view><view class="title fade-in">现场任务</view><view class="subtitle fade-in">把异常变成下一步，而不是一条被忽略的通知。</view><view class="task-summary card-dark fade-in delay-1"><view><view class="summary-kicker">TODAY / OPEN LOOP</view><view class="summary-title">{{tasks.length}}<text> 项待处理</text></view><view class="summary-note">云端任务与需要授权的审批分开显示</view></view><view class="summary-check">✓</view></view><view class="task-tabs fade-in delay-1"><button class="task-tab {{filter === 'open' ? 'tab-active' : ''}}" data-filter="open" bindtap="selectFilter">待处理</button><button class="task-tab {{filter === 'done' ? 'tab-active' : ''}}" data-filter="done" bindtap="selectFilter">已完成</button><button class="task-tab {{filter === 'all' ? 'tab-active' : ''}}" data-filter="all" bindtap="selectFilter">全部</button></view><view class="task-list fade-in delay-2"><block wx:for="{{tasks}}" wx:key="id"><block wx:if="{{filter === 'all' || (filter === 'done' && item.done) || (filter === 'open' && !item.done)}}"><view class="task-card card {{item.done ? 'task-done' : ''}}"><button class="task-check {{item.done ? 'check-done' : ''}}" data-id="{{item.id}}" bindtap="toggleTask">{{item.done ? '✓' : ''}}</button><view class="task-main"><view class="task-meta"><text class="tag tag-{{item.type === 'urgent' ? 'amber' : item.type === 'maintenance' ? 'cyan' : item.type === 'done' ? 'green' : 'purple'}}">{{item.label}}</text><text class="task-due">{{item.due}}</text></view><view class="task-title">{{item.title}}</view><view class="task-detail">{{item.detail}}</view><view class="task-owner">负责人 · {{item.owner}}</view></view></view></block></block></view><view class="mobile-approvals" wx:if="{{approvals.length}}"><view class="mobile-section-label">CLOUD APPROVALS / MANAGER ACTION</view><block wx:for="{{approvals}}" wx:key="id"><view class="approval-card card"><view class="approval-type">{{item.type}} · {{item.status}}</view><view class="approval-title">{{item.title}}</view><view class="approval-detail">{{item.projectName || '工作空间级'}} · {{item.objectType}} / {{item.objectId}}</view><button wx:if="{{item.status === 'pending' || item.status === 'replan'}}" class="approval-button" data-id="{{item.id}}" bindtap="decideApproval">批准审批</button></view></block></view><view class="new-task card"><view class="new-task-label">ADD A FIELD NOTE</view><input value="{{newTask}}" placeholder="记录一个需要跟进的小事…" bindinput="inputTask" maxlength="60" confirm-type="done" /><button class="new-task-button" bindtap="addTask">添加任务 +</button></view></view>
