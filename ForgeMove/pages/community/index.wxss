.community-head { display: flex; align-items: flex-end; justify-content: space-between; }.community-head .title { max-width: 500rpx; }.compose-top { min-height: 62rpx; padding: 0 18rpx; color: #fff; background: var(--fm-purple); font-size: 22rpx; font-weight: 700; }.community-copy { max-width: 630rpx; margin-top: 15rpx; color: var(--fm-muted); font-size: 23rpx; line-height: 1.65; }.community-status { display: flex; align-items: center; margin-top: 25rpx; padding: 15rpx 0; border-top: 1rpx solid var(--fm-line); border-bottom: 1rpx solid var(--fm-line); color: var(--fm-ink); font-size: 20rpx; }.status-right { margin-left: auto; color: var(--fm-muted); font-family: monospace; font-size: 16rpx; }.community-search { display: flex; height: 70rpx; align-items: center; gap: 9rpx; margin-top: 18rpx; padding: 0 16rpx; }.community-search text { color: var(--fm-purple); font-size: 34rpx; }.community-search input { min-width: 0; flex: 1; height: 100%; color: var(--fm-ink); font-size: 22rpx; }.community-search input::placeholder { color: #a0aaab; }.community-tabs { display: flex; margin-top: 14rpx; border-bottom: 1rpx solid var(--fm-line); }.community-tab { min-height: 67rpx; margin-right: 28rpx; color: var(--fm-muted); font-size: 22rpx; }.community-active { color: var(--fm-purple); border-bottom: 4rpx solid var(--fm-purple); font-weight: 800; }.feed-list { display: grid; gap: 14rpx; margin-top: 20rpx; }.feed-card { padding: 20rpx 18rpx 16rpx; }.feed-top { display: flex; align-items: center; }.avatar { display: flex; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; margin-right: 12rpx; color: #fff; font-family: Georgia, serif; font-size: 24rpx; font-weight: 700; }.avatar.tone-purple { background: var(--fm-purple); }.avatar.tone-cyan { background: var(--fm-green); }.avatar.tone-amber { color: var(--fm-ink); background: var(--fm-amber); }.avatar.tone-green { background: #55aa70; }.feed-author { min-width: 0; flex: 1; }.author-name { overflow: hidden; color: var(--fm-ink); font-size: 22rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }.author-role { margin-top: 4rpx; color: var(--fm-muted); font-family: monospace; font-size: 15rpx; }.feed-title { display: block; width: 100%; margin-top: 19rpx; color: var(--fm-ink); font-size: 27rpx; font-weight: 800; line-height: 1.4; }.feed-body { margin-top: 9rpx; color: var(--fm-muted); font-size: 20rpx; line-height: 1.65; }.feed-actions { display: flex; align-items: center; gap: 21rpx; margin-top: 18rpx; padding-top: 13rpx; border-top: 1rpx solid var(--fm-line); color: var(--fm-muted); font-family: monospace; font-size: 17rpx; }.feed-action { color: var(--fm-muted); font-family: monospace; font-size: 17rpx; }.feed-action.liked { color: var(--fm-red); }.feed-open { margin-left: auto; color: var(--fm-purple); }.community-note { margin-top: 25rpx; padding: 23rpx 21rpx; }.note-kicker { color: #e1aa23; font-family: monospace; font-size: 16rpx; letter-spacing: .1em; }.note-title { margin-top: 12rpx; color: #f4f6f1; font-family: Georgia, serif; font-size: 31rpx; font-weight: 700; }.note-copy { margin-top: 9rpx; color: rgba(244,246,241,.6); font-size: 20rpx; line-height: 1.7; }.composer-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(18,25,28,.65); }.composer-card { width: 100%; padding: 28rpx 26rpx 35rpx; border-radius: 28rpx 28rpx 0 0; background: var(--fm-paper); box-shadow: 0 -10rpx 35rpx rgba(0,0,0,.18); }.composer-head { display: flex; align-items: flex-start; justify-content: space-between; }.composer-title { margin-top: 10rpx; color: var(--fm-ink); font-family: Georgia, serif; font-size: 34rpx; font-weight: 700; }.close-button { color: var(--fm-muted); font-size: 40rpx; }.composer-card textarea { width: 100%; min-height: 210rpx; margin-top: 24rpx; padding: 16rpx; border: 1rpx solid var(--fm-line); color: var(--fm-ink); background: rgba(255,255,255,.8); font-size: 24rpx; line-height: 1.65; }.composer-card textarea::placeholder { color: #a0aaab; }.composer-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 15rpx; color: var(--fm-muted); font-family: monospace; font-size: 17rpx; }.composer-submit { min-height: 66rpx; font-size: 21rpx; }

