.monitor-toolbar { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 32rpx; padding: 17rpx 0; border-top: 1rpx solid var(--fm-line); border-bottom: 1rpx solid var(--fm-line); }.toolbar-label { display: block; color: var(--fm-muted); font-family: monospace; font-size: 16rpx; letter-spacing: .08em; }.toolbar-value { display: block; margin-top: 7rpx; color: var(--fm-ink); font-family: monospace; font-size: 19rpx; }.line-stack { display: grid; gap: 16rpx; margin-top: 22rpx; }.line-card { display: block; width: 100%; padding: 22rpx 20rpx 17rpx; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }.line-selected { border-color: var(--fm-purple); box-shadow: 8rpx 8rpx 0 rgba(124,94,222,.16); transform: translateY(-3rpx); }.line-card-head { display: flex; align-items: flex-start; justify-content: space-between; }.line-code { color: var(--fm-purple); font-family: monospace; font-size: 16rpx; font-weight: 700; letter-spacing: .06em; }.line-name { margin-top: 8rpx; color: var(--fm-ink); font-size: 27rpx; font-weight: 800; }.line-status { display: flex; align-items: center; color: var(--fm-muted); font-size: 18rpx; }.line-metrics { display: grid; grid-template-columns: 1fr 1fr 1fr; margin-top: 26rpx; padding: 15rpx 0; border-top: 1rpx solid var(--fm-line); border-bottom: 1rpx solid var(--fm-line); }.metric-number { display: block; color: var(--fm-ink); font-family: Georgia, serif; font-size: 37rpx; font-weight: 700; }.metric-number text { color: var(--fm-muted); font-family: monospace; font-size: 17rpx; }.metric-caption { display: block; margin-top: 4rpx; color: var(--fm-muted); font-size: 17rpx; }.trend-bars { display: flex; height: 52rpx; align-items: flex-end; gap: 5rpx; margin-top: 20rpx; }.bar { width: 100%; background: var(--fm-green); opacity: .65; }.bar-1 { height: 42%; }.bar-2 { height: 61%; }.bar-3 { height: 57%; }.bar-4 { height: 72%; }.bar-5 { height: 48%; }.bar-6 { height: 78%; }.bar-7 { height: 65%; }.bar-8 { height: 85%; }.bar-9 { height: 76%; }.bar-10 { height: 92%; }.bar-11 { height: 80%; }.bar-12 { height: 96%; }.line-note { display: flex; justify-content: space-between; margin-top: 15rpx; color: var(--fm-muted); font-size: 18rpx; }.line-arrow { color: var(--fm-purple); font-size: 28rpx; }.monitor-footer { margin-top: 26rpx; padding: 25rpx 22rpx; }.footer-kicker { color: #e1aa23; font-family: monospace; font-size: 16rpx; letter-spacing: .08em; }.footer-title { margin-top: 12rpx; color: #f4f6f1; font-family: Georgia, serif; font-size: 32rpx; font-weight: 700; }.footer-copy { margin-top: 10rpx; color: rgba(244,246,241,.6); font-size: 21rpx; line-height: 1.7; }.footer-button { display: flex; min-height: 72rpx; align-items: center; justify-content: center; margin-top: 18rpx; border: 1rpx solid #e1aa23; color: #e1aa23; font-size: 22rpx; font-weight: 700; }

