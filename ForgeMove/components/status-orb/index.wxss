.orb-wrap { display: flex; align-items: center; gap: 16rpx; }
.orb { display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(63,179,167,.6); border-radius: 50%; background: radial-gradient(circle, rgba(63,179,167,.36), rgba(63,179,167,.04) 58%, transparent 59%); box-shadow: 0 0 0 12rpx rgba(63,179,167,.08), 0 0 36rpx rgba(63,179,167,.26); animation: orbPulse 2.5s ease-in-out infinite; }
.orb-core { width: 24rpx; height: 24rpx; border-radius: 50%; background: #68ded0; box-shadow: 0 0 18rpx #68ded0; }
.orb-warning { border-color: rgba(225,170,35,.8); background: radial-gradient(circle, rgba(225,170,35,.36), rgba(225,170,35,.04) 58%, transparent 59%); box-shadow: 0 0 0 12rpx rgba(225,170,35,.08), 0 0 36rpx rgba(225,170,35,.25); }
.orb-warning .orb-core { background: #f4c74f; box-shadow: 0 0 18rpx #f4c74f; }
.orb-idle { border-color: rgba(150,163,166,.52); background: radial-gradient(circle, rgba(150,163,166,.28), rgba(150,163,166,.04) 58%, transparent 59%); box-shadow: 0 0 0 12rpx rgba(150,163,166,.06); animation: none; }
.orb-idle .orb-core { background: #a5b0b1; box-shadow: none; }
.orb-label { color: rgba(244,246,241,.74); font-family: monospace; font-size: 19rpx; font-weight: 700; letter-spacing: .11em; }
.orb-compact .orb { width: 54rpx; height: 54rpx; box-shadow: none; }
.orb-compact .orb-core { width: 16rpx; height: 16rpx; }
@keyframes orbPulse { 0%, 100% { transform: scale(.98); opacity: .8; } 50% { transform: scale(1.04); opacity: 1; } }

